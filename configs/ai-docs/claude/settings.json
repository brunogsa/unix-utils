{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit(//tmp/**)",
      "Edit(//private/tmp/**)",
      "Write(//tmp/**)",
      "Write(//private/tmp/**)",
      "WebFetch",
      "WebSearch",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskOutput",
      "TaskStop",
      "Bash(/Users/brunoagostini/unix-utils/configs/ai-docs/claude/skills/doc-standards/scripts/check-density.sh *)",
      "Bash(bash /Users/brunoagostini/unix-utils/configs/ai-docs/claude/skills/doc-standards/scripts/check-density.sh *)",
      "Bash(/home/brunogsa/unix-utils/configs/ai-docs/claude/skills/doc-standards/scripts/check-density.sh *)",
      "Bash(bash /home/brunogsa/unix-utils/configs/ai-docs/claude/skills/doc-standards/scripts/check-density.sh *)",
      "Bash(/Users/brunoagostini/unix-utils/configs/ai-docs/claude/skills/performance-check-principles-and-skills/scripts/check.sh *)",
      "Bash(bash /Users/brunoagostini/unix-utils/configs/ai-docs/claude/skills/performance-check-principles-and-skills/scripts/check.sh *)",
      "Bash(/home/brunogsa/unix-utils/configs/ai-docs/claude/skills/performance-check-principles-and-skills/scripts/check.sh *)",
      "Bash(bash /home/brunogsa/unix-utils/configs/ai-docs/claude/skills/performance-check-principles-and-skills/scripts/check.sh *)",
      "Bash(/Users/brunoagostini/unix-utils/configs/ai-docs/claude/skills/open-in-tmux/scripts/open-in-tmux.sh *)",
      "Bash(bash /Users/brunoagostini/unix-utils/configs/ai-docs/claude/skills/open-in-tmux/scripts/open-in-tmux.sh *)",
      "Bash(/home/brunogsa/unix-utils/configs/ai-docs/claude/skills/open-in-tmux/scripts/open-in-tmux.sh *)",
      "Bash(bash /home/brunogsa/unix-utils/configs/ai-docs/claude/skills/open-in-tmux/scripts/open-in-tmux.sh *)",
      "Bash(mmdc *)",
      "Bash(shellcheck *)",
      "Bash(git-hunk list *)",
      "Bash(git-hunk show *)",
      "Bash(claude doctor *)",
      "Bash(npm view *)",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_read_thread"
    ],
    "deny": [
      "Bash(read:~/.ssh/**)",
      "Bash(read:~/.gnupg/**)",
      "Bash(read:~/.git-credentials)",
      "Bash(read:~/.npmrc)",
      "Bash(read:~/.pypirc)",
      "Bash(read:~/.docker/config.json)",
      "Bash(read:~/.config/gh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-git-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-rm-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-tmux-notification.sh notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-tmux-notification.sh done"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "bash-language-server@claude-code-lsps": true,
    "terraform-ls@claude-code-lsps": true,
    "claude-hud@claude-hud": true,
    "security-guidance@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "understand-anything@understand-anything": true
  },
  "extraKnownMarketplaces": {
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "boostvolt/claude-code-lsps"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "advisorModel": "opus",
  "promptSuggestionEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "verbose": true,
  "preferredNotifChannel": "ghostty",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
