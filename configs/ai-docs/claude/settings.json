  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-git-guard.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-rm-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/subagent-model-guard.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-tmux-notification.sh notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-stop-orchestrator.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-tmux-title-reminder.sh"
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/tmux-window-title.sh --reset-counter"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-implement-compact-reminder.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-compact-skill-reload.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-tmux-title-compact-reminder.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/tmux-window-title.sh --bump-counter"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-tmux-title-restore.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'command -v ccburn >/dev/null 2>&1 && command -v ccstatusline >/dev/null 2>&1 && ccburn collect | ccstatusline; true'"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "bash-language-server@claude-code-lsps": true,
    "terraform-ls@claude-code-lsps": true,
    "claude-hud@claude-hud": true,
    "security-guidance@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "core@arco-ai-plugins": true,
    "audit@arco-ai-plugins": true,
    "sdd@arco-ai-plugins": true,
    "sdk@arco-ai-plugins": true
  },
  "extraKnownMarketplaces": {
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "boostvolt/claude-code-lsps"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "arco-ai-plugins": {
      "source": {
        "source": "git",
        "url": "git@github.com:OlaIsaac/arco-ai-plugins.git"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "promptSuggestionEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "verbose": true,
  "preferredNotifChannel": "ghostty",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
