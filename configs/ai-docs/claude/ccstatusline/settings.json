{
  "version": 3,
  "lines": [
    [
      { "id": "bracket-open", "type": "custom-text", "customText": "[", "merge": "no-padding" },
      { "id": "tier", "type": "custom-command", "commandPath": "$HOME/.claude/scripts/statusline-tier.sh tier", "timeout": 4000, "merge": "no-padding" },
      { "id": "bracket-close", "type": "custom-text", "customText": "]" },
      { "id": "model", "type": "model", "color": "cyan", "rawValue": true },
      { "id": "effort", "type": "thinking-effort", "rawValue": true },
      { "id": "advisor", "type": "custom-command", "commandPath": "$HOME/.claude/scripts/statusline-tier.sh advisor" },
      { "id": "sep-1", "type": "custom-text", "customText": "|" },
      { "id": "context-label", "type": "custom-text", "customText": "Ctx ", "merge": "no-padding" },
      { "id": "context-length", "type": "context-length", "rawValue": true },
      { "id": "context-percentage", "type": "context-percentage", "rawValue": true },
      { "id": "sep-2", "type": "custom-text", "customText": "|" },
      { "id": "session-cost", "type": "session-cost", "rawValue": true },
      { "id": "sep-3", "type": "custom-text", "customText": "|" },
      { "id": "duration-label", "type": "custom-text", "customText": "⏱ ", "merge": "no-padding" },
      { "id": "duration", "type": "custom-command", "commandPath": "$HOME/.claude/scripts/statusline-tier.sh duration", "merge": "no-padding" },
      { "id": "duration-unit", "type": "custom-text", "customText": "h" }
    ],
    [
      { "id": "5h-label", "type": "custom-text", "customText": "5h" },
      { "id": "session-usage", "type": "session-usage", "rawValue": true, "merge": "no-padding" },
      { "id": "5h-of-expected", "type": "custom-text", "customText": " (of ", "merge": "no-padding" },
      { "id": "expected5h", "type": "custom-command", "commandPath": "$HOME/.claude/scripts/statusline-tier.sh expected5h", "merge": "no-padding" },
      { "id": "5h-resets", "type": "custom-text", "customText": "%, resets ", "merge": "no-padding" },
      { "id": "reset-timer", "type": "reset-timer", "rawValue": true, "merge": "no-padding" },
      { "id": "5h-close", "type": "custom-text", "customText": ")" },
      { "id": "sep-5", "type": "custom-text", "customText": "|" },
      { "id": "7d-label", "type": "custom-text", "customText": "7d" },
      { "id": "weekly-usage", "type": "weekly-usage", "rawValue": true, "merge": "no-padding" },
      { "id": "7d-of-expected", "type": "custom-text", "customText": " (of ", "merge": "no-padding" },
      { "id": "expected7d", "type": "custom-command", "commandPath": "$HOME/.claude/scripts/statusline-tier.sh expected7d", "merge": "no-padding" },
      { "id": "7d-resets", "type": "custom-text", "customText": "%, resets ", "merge": "no-padding" },
      { "id": "weekly-reset-timer", "type": "weekly-reset-timer", "rawValue": true, "merge": "no-padding" },
      { "id": "7d-close", "type": "custom-text", "customText": ")" }
    ]
  ],
  "flexMode": "full-until-compact",
  "compactThreshold": 60,
  "colorLevel": 3,
  "inheritSeparatorColors": false,
  "globalBold": false,
  "minimalistMode": false,
  "powerline": {
    "enabled": false,
    "separators": [""],
    "separatorInvertBackground": [false],
    "startCaps": ["", ""],
    "endCaps": [""],
    "autoAlign": false,
    "continueThemeAcrossLines": false,
    "theme": "nord-aurora"
  },
  "defaultPadding": " ",
  "defaultPaddingSide": "left"
}
