{
  "version": 3,
  "lines": [
    [
      { "id": "bracket-open", "type": "custom-text", "customText": "[" },
      { "id": "tier", "type": "custom-command", "commandPath": "$HOME/.claude/scripts/statusline-tier.sh tier", "timeout": 4000 },
      { "id": "bracket-close", "type": "custom-text", "customText": "]" },
      { "id": "model", "type": "model", "color": "cyan", "rawValue": true },
      { "id": "effort", "type": "thinking-effort", "rawValue": true },
      { "id": "context-length", "type": "context-length" },
      { "id": "sep-1", "type": "custom-text", "customText": "|" },
      { "id": "advisor-label", "type": "custom-text", "customText": "Advisor" },
      { "id": "advisor", "type": "custom-command", "commandPath": "$HOME/.claude/scripts/statusline-tier.sh advisor" },
      { "id": "sep-2", "type": "custom-text", "customText": "|" },
      { "id": "context-label", "type": "custom-text", "customText": "Context" },
      { "id": "context-percentage", "type": "context-percentage" },
      { "id": "sep-3", "type": "custom-text", "customText": "|" },
      { "id": "cost-label", "type": "custom-text", "customText": "$" },
      { "id": "session-cost", "type": "session-cost" },
      { "id": "sep-4", "type": "custom-text", "customText": "|" },
      { "id": "duration", "type": "custom-command", "commandPath": "$HOME/.claude/scripts/statusline-tier.sh duration" },
      { "id": "duration-unit", "type": "custom-text", "customText": "h", "merge": "no-padding" }
    ],
    [
      { "id": "5h-label", "type": "custom-text", "customText": "5h" },
      { "id": "session-usage", "type": "session-usage" },
      { "id": "5h-of-expected", "type": "custom-text", "customText": "of expected" },
      { "id": "expected5h", "type": "custom-command", "commandPath": "$HOME/.claude/scripts/statusline-tier.sh expected5h" },
      { "id": "5h-resets", "type": "custom-text", "customText": "% (resets" },
      { "id": "reset-timer", "type": "reset-timer" },
      { "id": "5h-close", "type": "custom-text", "customText": ")", "merge": "no-padding" },
      { "id": "sep-5", "type": "custom-text", "customText": "|" },
      { "id": "7d-label", "type": "custom-text", "customText": "7d" },
      { "id": "weekly-usage", "type": "weekly-usage" },
      { "id": "7d-of-expected", "type": "custom-text", "customText": "of expected" },
      { "id": "expected7d", "type": "custom-command", "commandPath": "$HOME/.claude/scripts/statusline-tier.sh expected7d" },
      { "id": "7d-resets", "type": "custom-text", "customText": "% (resets" },
      { "id": "weekly-reset-timer", "type": "weekly-reset-timer" },
      { "id": "7d-close", "type": "custom-text", "customText": ")", "merge": "no-padding" }
    ]
  ],
  "flexMode": "full-until-compact",
  "compactThreshold": 60,
  "colorLevel": 3,
  "inheritSeparatorColors": false,
  "globalBold": false,
  "minimalistMode": false,
  "powerline": {
    "enabled": false,
    "separators": [""],
    "separatorInvertBackground": [false],
    "startCaps": ["", ""],
    "endCaps": [""],
    "autoAlign": false,
    "continueThemeAcrossLines": false,
    "theme": "nord-aurora"
  },
  "defaultPadding": " "
}
