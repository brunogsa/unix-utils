# Generated by install.sh from the pipx pytest venv path, which embeds the
# pipx home and the CPython minor version — both machine- and OS-specific.
# Pyright does not expand ${env:HOME} inside pyrightconfig.json, so no
# committed literal resolves on both macOS and Linux.
pyrightconfig.json
